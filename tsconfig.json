{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@data/*": [
        "../data/*"
      ],
      "@src/*": [
        "src/*"
      ],
      "@theme": [
        "src/theme/index"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "extends": "expo/tsconfig.base"
}
