{
  "name": "museo-vallenato-app",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación completa del Museo del Vallenato con panel admin integrado",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "deploy:vercel": "vercel --prod",
    "prebuild:android": "npx expo prebuild --platform android",
    "server": "node server/index.js",
    "dev:server": "nodemon server/index.js",
    "dev": "concurrently -n SERVER,APP -c green,magenta \"npm run dev:server\" \"npm run start\"",
    "generate": "node tools/generateAssets.mjs",
    "test-sync": "node tools/test-supabase-sync.js",
    "migrate": "node tools/migrate-library.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.1.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.28",
    "@supabase/supabase-js": "^2.83.0",
    "@types/react": "19.2.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "54.0.0",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.7",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.19",
    "expo-font": "~14.0.9",
    "expo-image-manipulator": "~14.0.7",
    "expo-linking": "~8.0.9",
    "expo-status-bar": "~3.0.8",
    "express": "^4.19.2",
    "framer-motion": "^12.0.0",
    "gsap": "^3.12.5",
    "jimp": "^0.22.10",
    "multer": "^1.4.5-lts.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@react-native-community/cli-server-api": "^20.0.2",
    "babel-preset-expo": "~54.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "metro": "^0.83.3",
    "metro-config": "^0.83.3",
    "nodemon": "^3.0.2",
    "typescript": "~5.3.3"
  }
}
